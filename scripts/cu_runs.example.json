  ["str_1mm/c1c",    "str_0.42mm/c1c",   "cross-length"],
  ["mini_1mm/c1w",   "mini_2mm/c1w",     "cross-length"],
  ["mini_2mm/c1w",   "mini_1mm/c1w",     "cross-length"],
  ["mini_1mm/c1c",   "mini_2mm/c1c",     "cross-length"],
  ["mini_2mm/c1c",   "mini_1mm/c1c",     "cross-length"]
